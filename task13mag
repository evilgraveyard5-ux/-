class Cart:
    """Корзина покупателя с магическими методами."""

    def __init__(self):
        self._items: dict[str, tuple[Product, int]] = {}

    def add(self, product: Product, qty: int = 1) -> None:
        if qty <= 0:
            raise ValueError("Количество должно быть больше нуля.")
        product.reserve(qty)
        if product.sku in self._items:
            _, cur_qty = self._items[product.sku]
            self._items[product.sku] = (product, cur_qty + qty)
        else:
            self._items[product.sku] = (product, qty)

    def remove(self, sku: str, qty: int = 1) -> int:
        if sku not in self._items:
            raise KeyError(f"Товара '{sku}' нет в корзине.")
        product, cur_qty = self._items[sku]
        if qty <= 0 or qty > cur_qty:
            raise ValueError("Некорректное количество для удаления из корзины.")
        product.release(qty)
        if cur_qty == qty:
            del self._items[sku]
        else:
            self._items[sku] = (product, cur_qty - qty)
        return qty

    def clear(self) -> None:
        self._items.clear()

    def items_list(self) -> list[tuple[Product, int]]:
        return list(self._items.values())

    def subtotal(self) -> float:
        return round(sum(p.price * q for p, q in self._items.values()), 2)

    def __len__(self) -> int:
        return sum(q for _, q in self._items.values())

    def __iter__(self):
        return iter(self._items.values())

    def __contains__(self, sku: object) -> bool:
        return sku in self._items

    def __add__(self, other: Cart) -> Cart:
        if not isinstance(other, Cart):
            return NotImplemented
        merged = Cart()
        for p, q in self._items.values():
            merged._items[p.sku] = (p, q)
        for p, q in other._items.values():
            if p.sku in merged._items:
                ep, eq = merged._items[p.sku]
                merged._items[p.sku] = (ep, eq + q)
            else:
                merged._items[p.sku] = (p, q)
        return merged

    def __str__(self) -> str:
        if not self._items:
            return "Корзина пуста."
        lines = [f"  - {p.name} ({p.sku}) x{q} = {p.price * q:.2f}" for p, q in self._items.values()]
        lines.append(f"Итого без скидок и налогов: {self.subtotal():.2f}")
        return "\n".join(lines)

    def to_dict(self) -> dict:
        return {
            "items": [
                {"sku": p.sku, "qty": q}
                for p, q in self._items.values()
            ]
        }


class Customer:
    """Покупатель и история его чеков."""

    def __init__(self, name: str, balance: float = 100000.0):
        self._name = name
        self._balance = float(balance)
        self._receipts: list[Receipt] = []

    @property
    def name(self) -> str:
        return self._name

    @property
    def balance(self) -> float:
        return self._balance

    @property
    def receipts(self) -> list[Receipt]:
        return self._receipts

    def charge(self, amount: float) -> None:
        if amount < 0:
            raise ValueError("Сумма списания не может быть отрицательной.")
        if self._balance < amount:
            raise ShopStateError(f"Недостаточно средств: баланс {self._balance:.2f}, нужно {amount:.2f}.")
        self._balance = round(self._balance - amount, 2)

    def refund(self, amount: float) -> None:
        if amount < 0:
            raise ValueError("Сумма возврата не может быть отрицательной.")
        self._balance = round(self._balance + amount, 2)

    def add_receipt(self, receipt: Receipt) -> None:
        self._receipts.append(receipt)

    def __str__(self) -> str:
        return f"Покупатель: {self._name} | Баланс: {self._balance:.2f} | Чеков: {len(self._receipts)}"

    def to_dict(self) -> dict:
        return {
            "name": self._name,
            "balance": self._balance,
            "receipts": [r.to_dict() for r in self._receipts],
        }

    @classmethod
    def from_dict(cls, data: dict) -> Customer:
        cust = cls(data.get("name", "Гость"), data.get("balance", 100000.0))
        cust._receipts = [Receipt.from_dict(r) for r in data.get("receipts", [])]
        return cust


class Receipt:
    """Чек с разбивкой по позициям, скидке и налогам."""

    def __init__(
        self,
        receipt_id: int,
        customer_name: str,
        lines: list[dict],
        promo_name: str,
        discount_total: float,
        tax_total: float,
        grand_total: float,
        created_at: str | None = None,
    ):
        self.receipt_id = receipt_id
        self.customer_name = customer_name
        self.lines = lines
        self.promo_name = promo_name
        self.discount_total = round(discount_total, 2)
        self.tax_total = round(tax_total, 2)
        self.grand_total = round(grand_total, 2)
        self.created_at = created_at or datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.returned_qty: dict[str, int] = {}

    def __str__(self) -> str:
        out = [
            f"=== ЧЕК #{self.receipt_id} ({self.created_at}) ===",
            f"Покупатель: {self.customer_name}",
        ]
        for ln in self.lines:
            ret = self.returned_qty.get(ln["sku"], 0)
            ret_str = f" [возвращено: {ret}]" if ret else ""
            out.append(
                f"  {ln['name']} ({ln['sku']}) | {ln['qty']} шт. x {ln['unit_price']:.2f} "
                f"= {ln['line_sum']:.2f} | налог: {ln['tax_amount']:.2f}{ret_str}"
            )
        out.append(f"Акция: {self.promo_name} | Скидка: -{self.discount_total:.2f}")
        out.append(f"Итого налоги: {self.tax_total:.2f}")
        out.append(f"К ОПЛАТЕ: {self.grand_total:.2f}")
        return "\n".join(out)

    def to_dict(self) -> dict:
        return {
            "receipt_id": self.receipt_id,
            "customer_name": self.customer_name,
            "lines": self.lines,
            "promo_name": self.promo_name,
            "discount_total": self.discount_total,
            "tax_total": self.tax_total,
            "grand_total": self.grand_total,
            "created_at": self.created_at,
            "returned_qty": self.returned_qty,
        }

    @classmethod
    def from_dict(cls, data: dict) -> Receipt:
        r = cls(
            receipt_id=data["receipt_id"],
            customer_name=data["customer_name"],
            lines=data["lines"],
            promo_name=data.get("promo_name", "Без акции"),
            discount_total=data.get("discount_total", 0.0),
            tax_total=data.get("tax_total", 0.0),
            grand_total=data.get("grand_total", 0.0),
            created_at=data.get("created_at"),
        )
        r.returned_qty = dict(data.get("returned_qty", {}))
        return r

