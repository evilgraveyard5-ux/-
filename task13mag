class PerishableFood(Food):
    """Второй уровень наследования: Product -> Food -> PerishableFood."""

    def __init__(self, sku: str, name: str, price: float, stock: int, shelf_life_days: int = 5, tax_rate: float = 0.05):
        super().__init__(sku, name, price, stock, tax_rate=tax_rate)
        self.__shelf_life_days = max(1, int(shelf_life_days))

    @property
    def shelf_life_days(self) -> int:
