from __future__ import annotations
from abc import ABC, abstractmethod

from mod import Product


class Promotion(ABC):
    """Абстрактная акция: вычисляет размер скидки для набора позиций (product, qty)."""

    def __init__(self, name: str):
        self._name = name

    @property
    def name(self) -> str:
        return self._name

    @abstractmethod
    def discount_amount(self, items: list[tuple[Product, int]]) -> float:
        pass

    def __str__(self) -> str:
        return f"Акция '{self._name}'"


class DiscountPromotion(Promotion):
    """Процентная скидка на весь заказ при сумме от min_sum."""

    def __init__(self, name: str, percent: float, min_sum: float = 0.0):
        super().__init__(name)
        self._percent = float(percent)
        self._min_sum = float(min_sum)

    def discount_amount(self, items: list[tuple[Product, int]]) -> float:
        subtotal = sum(p.price * q for p, q in items)
        if subtotal < self._min_sum:
            return 0.0
        return round(subtotal * (self._percent / 100.0), 2)


class TwoForOnePromotion(Promotion):
    """Каждый второй экземпляр конкретного SKU — со скидкой 100% (2 по цене 1)."""

    def __init__(self, name: str, target_sku: str):
        super().__init__(name)
        self._target_sku = target_sku

    def discount_amount(self, items: list[tuple[Product, int]]) -> float:
        discount = 0.0
        for product, qty in items:
            if product.sku == self._target_sku and qty >= 2:
                free_units = qty // 2
                discount += free_units * product.price
        return round(discount, 2)


class BundlePromotion(Promotion):
    """Скидка при одновременной покупке всех SKU из набора."""

    def __init__(self, name: str, required_skus: set[str], bundle_discount: float):
        super().__init__(name)
        self._required_skus = set(required_skus)
        self._bundle_discount = float(bundle_discount)

    def discount_amount(self, items: list[tuple[Product, int]]) -> float:
        present = {p.sku for p, q in items if q > 0}
        if self._required_skus.issubset(present):
            subtotal = sum(p.price * q for p, q in items)
            return round(min(self._bundle_discount, subtotal), 2)
        return 0.0

