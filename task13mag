    def _log(self, message: str) -> None:
        stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with self.LOG_FILE.open("a", encoding="utf-8") as f:
            f.write(f"[{stamp}] [tick={self._tick}] {message}\n")

    def _advance_tick(self, steps: int = 1) -> None:
        for _ in range(max(1, steps)):
            self._tick += 1
            if self._tick % 3 == 0 and "E1" in self._catalog:
                self._catalog["E1"].adjust_price(1.02)
                msg = f"Событие мира: инфляция подняла цену на {self._catalog['E1'].name} (+2%)."
                self._log(msg)
                print(f"[Событие] {msg}")
            if self._tick % 5 == 0 and "P2" in self._catalog:
                self._catalog["P2"].release(3)
                msg = f"Событие мира: поставка +3 шт. {self._catalog['P2'].name} на склад."
                self._log(msg)
                print(f"[Событие] {msg}")

    def select_best_promotion(self, items: list[tuple[Product, int]]) -> tuple[Promotion | None, float]:
        best_promo: Promotion | None = None
        best_discount = 0.0
        for promo in self._promotions:
            disc = promo.discount_amount(items)
            if disc > best_discount:
                best_discount = disc
                best_promo = promo
        return best_promo, round(best_discount, 2)

    def cmd_help(self, args: list[str]) -> None:
        print("\n=== КОМАНДЫ МАГАЗИНА ===")
        for cmd, (_, desc) in self._commands.items():
            print(f"  {cmd:<10} — {desc}")

    def cmd_catalog(self, args: list[str]) -> None:
        print(f"\n=== КАТАЛОГ И СКЛАД (всего позиций: {len(self._catalog)}) ===")
        for prod in sorted(self._catalog.values()):
            print(" ", prod.describe())

    def cmd_add(self, args: list[str]) -> None:
        if len(args) != 2:
            raise InvalidCommandError("Использование: add <sku> <кол-во>")
        sku = args[0].upper()
        if sku not in self._catalog:
            raise InvalidCommandError(f"Товар с кодом {sku} не найден.")
        try:
            qty = int(args[1])
        except ValueError as exc:
            raise InvalidCommandError("Количество должно быть целым числом.") from exc
        self._cart.add(self._catalog[sku], qty)
        self._log(f"Добавлено в корзину: {sku} x{qty}")
        print(f"Добавлено в корзину: {self._catalog[sku].name} x{qty}")

    def cmd_remove(self, args: list[str]) -> None:
        if len(args) != 2:
            raise InvalidCommandError("Использование: remove <sku> <кол-во>")
        sku = args[0].upper()
        try:
            qty = int(args[1])
        except ValueError as exc:
            raise InvalidCommandError("Количество должно быть целым числом.") from exc
        try:
            removed = self._cart.remove(sku, qty)
        except (KeyError, ValueError) as exc:
            raise InvalidCommandError(str(exc)) from exc
        self._log(f"Удалено из корзины: {sku} x{removed}")
        print(f"Убрано из корзины: {sku} x{removed}")

    def cmd_cart(self, args: list[str]) -> None:
        print("\n=== КОРЗИНА ===")
        print(self._cart)

    def cmd_promo(self, args: list[str]) -> None:
        items = self._cart.items_list()
        promo, disc = self.select_best_promotion(items)
        if promo is None or disc <= 0:
            print("Подходящих акций пока нет (скидка 0.00).")
        else:
            print(f"Лучшая акция: {promo.name} -> скидка {disc:.2f}")

    def cmd_buy(self, args: list[str]) -> None:
        items = self._cart.items_list()
        if not items:
            raise ShopStateError("Корзина пуста. Сначала добавьте товар командой add.")

        promo, discount_total = self.select_best_promotion(items)
        subtotal = self._cart.subtotal()
        promo_ratio = (discount_total / subtotal) if subtotal > 0 else 0.0

        lines = []
        tax_total = 0.0
        for prod, qty in items:
            raw_line = prod.price * qty
            discounted_line = raw_line * (1.0 - promo_ratio)
            line_tax = round(discounted_line * prod.tax_rate, 2)
            tax_total += line_tax
            lines.append({
                "sku": prod.sku,
                "name": prod.name,
                "qty": qty,
                "unit_price": prod.price,
                "line_sum": round(raw_line, 2),
                "tax_amount": line_tax,
            })

        tax_total = round(tax_total, 2)
        grand_total = round(max(0.0, subtotal - discount_total + tax_total), 2)

        self._customer.charge(grand_total)
        receipt_id = len(self._customer.receipts) + 1
        receipt = Receipt(
            receipt_id=receipt_id,
            customer_name=self._customer.name,
            lines=lines,
            promo_name=promo.name if promo and discount_total > 0 else "Без акции",
            discount_total=discount_total,
            tax_total=tax_total,
            grand_total=grand_total,
        )
        self._customer.add_receipt(receipt)
        self._cart.clear()
        self._log(f"Оформлен чек #{receipt_id} на сумму {grand_total:.2f}")
        print("\n" + str(receipt))

    def cmd_receipts(self, args: list[str]) -> None:
        if not self._customer.receipts:
            print("Чеков пока нет.")
            return
        for r in self._customer.receipts:
            print("\n" + str(r))

    def cmd_return(self, args: list[str]) -> None:
        if len(args) != 3:
            raise InvalidCommandError("Использование: return <id_чека> <sku> <кол-во>")
        try:
            rec_id = int(args[0])
            qty = int(args[2])
        except ValueError as exc:
            raise InvalidCommandError("ID чека и количество должны быть целыми числами.") from exc
        sku = args[1].upper()
        if qty <= 0:
            raise ReturnError("Количество для возврата должно быть больше нуля.")

        receipt = next((r for r in self._customer.receipts if r.receipt_id == rec_id), None)
        if receipt is None:
            raise ReturnError(f"Чек #{rec_id} не найден.")

        line = next((ln for ln in receipt.lines if ln["sku"] == sku), None)
        if line is None:
            raise ReturnError(f"Товар {sku} отсутствует в чеке #{rec_id}.")

        already_returned = receipt.returned_qty.get(sku, 0)
        if already_returned + qty > line["qty"]:
            raise ReturnError(
                f"Нельзя вернуть {qty} шт. {sku}: куплено {line['qty']}, уже возвращено {already_returned}."
            )

        receipt.returned_qty[sku] = already_returned + qty
        if sku in self._catalog:
            self._catalog[sku].release(qty)

        per_unit_gross = (line["line_sum"] + line["tax_amount"]) / line["qty"]
        refund_sum = round(per_unit_gross * qty, 2)
        self._customer.refund(refund_sum)
        self._log(f"Возврат по чеку #{rec_id}: {sku} x{qty}, возвращено средств {refund_sum:.2f}")
        print(f"Возврат выполнен: {sku} x{qty}. На баланс возвращено {refund_sum:.2f}.")

    def cmd_tick(self, args: list[str]) -> None:
        steps = 1
        if args:
            try:
                steps = int(args[0])
            except ValueError as exc:
                raise InvalidCommandError("Число тактов должно быть целым.") from exc
        self._advance_tick(steps)
        print(f"Текущий такт мира: {self._tick}")

    def cmd_save(self, args: list[str]) -> None:
        self.save_to_file(self.SAVE_FILE)
        print(f"Состояние сохранено в {self.SAVE_FILE}")

    def cmd_load(self, args: list[str]) -> None:
        self.load_from_file(self.SAVE_FILE)
        print(f"Состояние загружено из {self.SAVE_FILE}")

    def cmd_demo(self, args: list[str]) -> None:
        demo_commands = [
            "catalog",
            "add F2 1",
            "add P2 2",
            "add E2 1",
            "promo",
            "cart",
            "buy",
            "tick 3",
            "return 1 P2 1",
            "receipts",
        ]
        print("\n=== ЗАПУСК DEMO ===")
        for line in demo_commands:
            print(f"\n[demo] > {line}")
            self.execute(line, advance_world=False)

    def cmd_exit(self, args: list[str]) -> bool:
        self.save_to_file(self.SAVE_FILE)
        self._log("Выход из программы с сохранением.")
        print("Состояние сохранено. До встречи!")
        return True

    def execute(self, raw_line: str, advance_world: bool = True) -> bool:
        parts = raw_line.strip().split()
        if not parts:
            return False
        cmd_name = parts[0].lower()
        args = parts[1:]
        if cmd_name not in self._commands:
            raise InvalidCommandError(f"Неизвестная команда {cmd_name}. Введите help.")
        handler, _ = self._commands[cmd_name]
        should_exit = bool(handler(args))
        if advance_world and cmd_name not in ("exit", "save", "load", "help"):
            self._advance_tick(1)
        return should_exit

    def to_dict(self) -> dict:
        return {
            "name": self._name,
            "tick": self._tick,
            "catalog": {sku: p.to_dict() for sku, p in self._catalog.items()},
            "cart": self._cart.to_dict(),
            "customer": self._customer.to_dict(),
        }

    def save_to_file(self, path: Path) -> None:
        path.write_text(json.dumps(self.to_dict(), ensure_ascii=False, indent=2), encoding="utf-8")
        self._log(f"Сохранение в {path}")

    def load_from_file(self, path: Path) -> None:
        if not path.exists():
            raise ShopStateError(f"Файл сохранения {path} не найден.")
        data = json.loads(path.read_text(encoding="utf-8"))
        self._name = data.get("name", self._name)
        self._tick = int(data.get("tick", 0))
        self._catalog = {
            sku: Product.from_dict(p_data)
            for sku, p_data in data.get("catalog", {}).items()
        }
        self._customer = Customer.from_dict(data.get("customer", {}))
        self._cart = Cart()
        for item in data.get("cart", {}).get("items", []):
            sku = item["sku"]
            if sku in self._catalog:
                self._cart.add(self._catalog[sku], int(item["qty"]))
        self._log(f"Загрузка из {path}")

    def __str__(self) -> str:
        return f"Магазин {self._name} (такт={self._tick}, товаров={len(self._catalog)}, {self._customer})"

    def run(self) -> None:
        print(f"=== {self._name.upper()} ===")
        print("Введите help для списка команд.")
        while True:
            try:
                line = input("\n> ")
                if self.execute(line):
                    break
            except ProjectError as err:
                print(f"[Ошибка]: {err}")
            except ValueError as err:
                print(f"[Ошибка значения]: {err}")
            except Exception as err:
                self._log(f"Непредвиденная ошибка: {err}")
                print(f"[Непредвиденная ошибка]: {err}")

