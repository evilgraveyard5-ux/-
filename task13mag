from __future__ import annotations
from abc import ABC, abstractmethod
from datetime import datetime

from exc import OutOfStockError, ShopStateError


class Product(ABC):
    """Базовый товар (наследование: Product -> Food -> PerishableFood, Electronics)."""

    def __init__(self, sku: str, name: str, price: float, stock: int, tax_rate: float = 0.12):
        self._sku = self._validate_non_empty(sku, "SKU")
        self._name = self._validate_non_empty(name, "Название")
        self.price = price
        self.stock = stock
        self._tax_rate = float(tax_rate)

    @staticmethod
    def _validate_non_empty(value: str, field_name: str) -> str:
        if not isinstance(value, str) or not value.strip():
            raise ValueError(f"{field_name} не может быть пустым.")
        return value.strip()

    @property
    def sku(self) -> str:
        return self._sku

    @property
    def name(self) -> str:
        return self._name

    @property
    def price(self) -> float:
        return self._price

    @price.setter
    def price(self, value: float) -> None:
        val = float(value)
        if val <= 0:
            raise ValueError("Цена должна быть больше нуля.")
        self._price = round(val, 2)

    @property
    def stock(self) -> int:
        return self._stock

    @stock.setter
    def stock(self, value: int) -> None:
        val = int(value)
        if val < 0:
            raise ValueError("Остаток на складе не может быть отрицательным.")
        self._stock = val

    @property
    def tax_rate(self) -> float:
        return self._tax_rate

    def adjust_price(self, factor: float) -> None:
        self.price = self._price * factor

    def reserve(self, qty: int) -> None:
        if qty <= 0:
            raise ValueError("Количество должно быть положительным.")
        if self._stock < qty:
            raise OutOfStockError(f"На складе '{self._name}' доступно {self._stock}, запрошено {qty}.")
        self._stock -= qty

    def release(self, qty: int) -> None:
        if qty <= 0:
            raise ValueError("Количество должно быть положительным.")
        self._stock += qty

    @abstractmethod
    def category(self) -> str:
        pass

    def describe(self) -> str:
        return (
            f"[{self.category()}] {self._name} ({self._sku}) — {self._price:.2f} "
            f"(остаток: {self._stock}, налог: {self._tax_rate*100:.0f}%)"
        )

    def __str__(self) -> str:
        return self.describe()

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, Product):
            return NotImplemented
        return self._sku == other._sku

    def __lt__(self, other: object) -> bool:
        if not isinstance(other, Product):
            return NotImplemented
        return self._price < other._price

    def to_dict(self) -> dict:
        return {
            "type": self.__class__.__name__,
            "sku": self._sku,
            "name": self._name,
            "price": self._price,
            "stock": self._stock,
            "tax_rate": self._tax_rate,
        }

    @classmethod
    def from_dict(cls, data: dict) -> Product:
        ptype = data.get("type", "Food")
        mapping = {
            "Food": Food,
            "PerishableFood": PerishableFood,
            "Electronics": Electronics,
        }
        target_cls = mapping.get(ptype, Food)
        if target_cls is PerishableFood:
            return PerishableFood(
                data["sku"],
                data["name"],
                data["price"],
                data["stock"],
                shelf_life_days=data.get("shelf_life_days", 7),
                tax_rate=data.get("tax_rate", 0.05),
            )
        if target_cls is Electronics:
            return Electronics(
                data["sku"],
                data["name"],
                data["price"],
                data["stock"],
                warranty_months=data.get("warranty_months", 12),
                tax_rate=data.get("tax_rate", 0.16),
            )
        return Food(
            data["sku"],
            data["name"],
            data["price"],
            data["stock"],
            tax_rate=data.get("tax_rate", 0.05),
        )


class Food(Product):
    def __init__(self, sku: str, name: str, price: float, stock: int, tax_rate: float = 0.05):
