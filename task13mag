from pathlib import Path
import tempfile

from exc import InvalidCommandError, OutOfStockError, ReturnError, ShopStateError
from mod import Cart, Electronics, Food, PerishableFood
from shp import Shop


def run_all_tests() -> None:
    # 1. Наследование (включая 2 уровня: Product -> Food -> PerishableFood) и @property
    yogurt = PerishableFood("P9", "Йогурт", 200.0, 5, shelf_life_days=3)
    assert isinstance(yogurt, Food)
    assert yogurt.shelf_life_days == 3
    assert yogurt.stock == 5

    # 2. Магические методы __eq__, __lt__ на товарах
    bread = Food("F9", "Хлеб", 150.0, 10)
    mouse = Electronics("E9", "Мышь", 3000.0, 4)
    assert bread < mouse
    assert bread == Food("F9", "Другое имя", 999.0, 1)

    # 3. Магические методы корзины (__len__, __contains__, __add__)
    c1 = Cart()
    c2 = Cart()
    c1.add(bread, 2)
    c2.add(mouse, 1)
    c3 = c1 + c2
    assert len(c3) == 3
    assert "F9" in c3
    assert "E9" in c3

    # 4. Покупка, автовыбор акции, чек и налоги
    with tempfile.TemporaryDirectory() as tmp:
        s = Shop("TestShop")
        s.SAVE_FILE = Path(tmp) / "state.json"
        s.LOG_FILE = Path(tmp) / "shop.log"
        s._seed_default_catalog()
        s._customer = s._customer.__class__("Тест", balance=50000.0)
        s._cart = Cart()

        s.execute("add F1 2", advance_world=False)
        s.execute("add E1 1", advance_world=False)
        s.execute("buy", advance_world=False)
        assert len(s._customer.receipts) == 1
        rec = s._customer.receipts[0]
        assert rec.grand_total > 0
        assert rec.tax_total > 0

        # 5. Корректный возврат товара
        prev_balance = s._customer.balance
        prev_stock = s._catalog["F1"].stock
        s.execute("return 1 F1 1", advance_world=False)
        assert s._customer.balance > prev_balance
        assert s._catalog["F1"].stock == prev_stock + 1

        # 6. Сохранение и загрузка JSON
        s.execute("save", advance_world=False)
        assert s.SAVE_FILE.exists()
        s2 = Shop("TestShop2")
        s2.SAVE_FILE = s.SAVE_FILE
        s2.LOG_FILE = s.LOG_FILE
        s2.load_from_file(s.SAVE_FILE)
        assert s2._customer.balance == s._customer.balance
        assert len(s2._customer.receipts) == 1

        # 7. Команда demo работает без ошибок
        s2.execute("demo", advance_world=False)
        assert len(s2._customer.receipts) >= 2

        # 8. Негативный тест: нехватка остатков на складе
        try:
            s2.execute("add E2 999", advance_world=False)
            assert False, "Ожидался OutOfStockError"
        except OutOfStockError:
            pass

        # 9. Негативный тест: возврат больше купленного
        try:
            s2.execute("return 1 F1 99", advance_world=False)
            assert False, "Ожидался ReturnError"
        except ReturnError:
            pass

        # 10. Негативный тест: неизвестная команда
        try:
            s2.execute("unknown_cmd", advance_world=False)
            assert False, "Ожидался InvalidCommandError"
        except InvalidCommandError:
            pass

        # 11. Негативный тест: некорректный ввод числа
        try:
            s2.execute("add F1 abc", advance_world=False)
            assert False, "Ожидался InvalidCommandError"
        except InvalidCommandError:
            pass

        # 12. Негативный тест: покупка при пустой корзине
        s2._cart = Cart()
        try:
            s2.execute("buy", advance_world=False)
            assert False, "Ожидался ShopStateError"
        except ShopStateError:
            pass

    print("Все 12 тестов успешно пройдены!")


if __name__ == "__main__":
    run_all_tests()
